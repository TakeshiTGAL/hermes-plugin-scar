{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TakeshiTGAL/hermes-plugin-scar/schemas/scar-ledger.schema.json",
  "title": "Scar ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["scar_ledger_version", "scars"],
  "properties": {
    "scar_ledger_version": {"const": 2},
    "scars": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "#/$defs/scar"}
    }
  },
  "$defs": {
    "scar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decision", "recorded_at", "tool", "arg_keys", "danger_tokens", "preview"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "decision": {"const": "deny"},
        "recorded_at": {"type": "string"},
        "tool": {"type": "string"},
        "arg_keys": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "danger_tokens": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["force", "recursive", "rm"]}
        },
        "preview": {"type": "string", "maxLength": 500}
      }
    }
  }
}
